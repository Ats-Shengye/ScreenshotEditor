<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Capture timing. The initial checked state comes from SettingsDataStore, not from XML. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_capture_timing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_capture_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rb_delay_none"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_immediate_capture" />

            <RadioButton
                android:id="@+id/rb_delay_1s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_delay_1s" />

            <RadioButton
                android:id="@+id/rb_delay_2s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_delay_2s" />

            <RadioButton
                android:id="@+id/rb_delay_3s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_delay_3s" />

            <RadioButton
                android:id="@+id/rb_delay_5s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_delay_5s" />
        </RadioGroup>

        <!-- Clipboard auto-clear -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clipboard_auto_clear"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_clipboard_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rb_clear_15s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_15s" />

            <RadioButton
                android:id="@+id/rb_clear_30s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_30s" />

            <RadioButton
                android:id="@+id/rb_clear_60s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_60s" />

            <RadioButton
                android:id="@+id/rb_clear_never"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_clear_never" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clipboard_auto_clear_note"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_reset_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_reset_defaults"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
